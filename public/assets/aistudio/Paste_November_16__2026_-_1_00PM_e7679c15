function generateSeasonSchedule(teams) {
  // 162 games per team = 2,592 total league games across 162 game days (16 games/day)
  // Using circle-method round-robin pairings to ensure every team plays 162 balanced games
  const ids = teams.map((t) => t.id);
  const n = ids.length; // 32
  const schedule = []; // Array of 162 days, each day has 16 matchups [homeId, awayId]

  const fixed = ids[0];
  let rotating = ids.slice(1);

  const singleRoundRobin = [];
  for (let round = 0; round < n - 1; round++) {
    const dayGames = [];
    const p1 = fixed;
    const p2 = rotating[0];
    dayGames.push(round % 2 === 0 ? [p1, p2] : [p2, p1]);

    for (let i = 1; i < n / 2; i++) {
      const tA = rotating[i];
      const tB = rotating[n - 1 - i];
      dayGames.push((round + i) % 2 === 0 ? [tA, tB] : [tB, tA]);
    }
    singleRoundRobin.push(dayGames);
    rotating = [rotating[rotating.length - 1], ...rotating.slice(0, rotating.length - 1)];
  }

  // Repeat cycles to reach 162 days (5 full 31-day cycles = 155 days + 7 extra days = 162 days)
  for (let d = 0; d < 162; d++) {
    const template = singleRoundRobin[d % singleRoundRobin.length];
    const flipHome = Math.floor(d / singleRoundRobin.length) % 2 === 1;
    schedule.push(
      template.map(([h, a]) => (flipHome ? [a, h] : [h, a]))
    );
  }
  return schedule;
}

function buildLineupAndPitching(roster) {
  const hitters = roster.filter((p) => !p.isPitcher).sort((a, b) => b.ovr - a.ovr);
  const sps = roster.filter((p) => p.position === "SP").sort((a, b) => b.ovr - a.ovr);
  const rps = roster.filter((p) => p.position === "RP").sort((a, b) => b.ovr - a.ovr);

  // Pick 9 starting hitters trying to fill positions
  const usedIds = new Set();
  const lineup = [];
  for (const pos of HITTER_POSITIONS) {
    const match = hitters.find((h) => h.position === pos && !usedIds.has(h.id));
    if (match) {
      usedIds.add(match.id);
      lineup.push(match);
    }
  }
  for (const h of hitters) {
    if (lineup.length >= 9) break;
    if (!usedIds.has(h.id)) {
      usedIds.add(h.id);
      lineup.push(h);
    }
  }
  // Bench hitters for pinch hitting / rest
  const bench = hitters.filter((h) => !usedIds.has(h.id));

  // Starting pitcher rotation (pick healthiest / top 5 rotation)
  const rotation = sps.length > 0 ? sps.slice(0, 5) : rps.slice(0, 5);
  const bullpen = rps.length > 0 ? rps : sps.slice(5);

  return { lineup, bench, rotation, bullpen };
}

function simulateSingleGame(homeTeam, awayTeam, homeRoster, awayRoster, gameDay) {
  const homeSetup = buildLineupAndPitching(homeRoster);
  const awaySetup = buildLineupAndPitching(awayRoster);

  const homeSP = homeSetup.rotation[gameDay % Math.max(1, homeSetup.rotation.length)] || homeRoster[0];
  const awaySP = awaySetup.rotation[gameDay % Math.max(1, awaySetup.rotation.length)] || awayRoster[0];

  // Team defensive glove average
  const homeGlove = homeSetup.lineup.reduce((acc, p) => acc + p.glove, 0) / Math.max(1, homeSetup.lineup.length);
  const awayGlove = awaySetup.lineup.reduce((acc, p) => acc + p.glove, 0) / Math.max(1, awaySetup.lineup.length);

  let homeRuns = 0;
  let awayRuns = 0;

  // Track game stats per player id
  const statDeltas = {};
  const ensureDelta = (p) => {
    if (!statDeltas[p.id]) {
      statDeltas[p.id] = p.isPitcher
        ? { g: 0, gs: 0, w: 0, l: 0, sv: 0, ipOuts: 0, h: 0, er: 0, bb: 0, so: 0 }
        : { g: 0, ab: 0, r: 0, h: 0, doubles: 0, triples: 0, hr: 0, rbi: 0, bb: 0, so: 0, sb: 0 };
    }
    return statDeltas[p.id];
  };

  homeSetup.lineup.forEach((p) => { ensureDelta(p).g = 1; });
  awaySetup.lineup.forEach((p) => { ensureDelta(p).g = 1; });
  if (homeSP) { const d = ensureDelta(homeSP); d.g = 1; d.gs = 1; }
  if (awaySP) { const d = ensureDelta(awaySP); d.g = 1; d.gs = 1; }

  let homeBatterIdx = 0;
  let awayBatterIdx = 0;
  let homePitcher = homeSP;
  let awayPitcher = awaySP;
  let homePitcherOuts = 0;
  let awayPitcherOuts = 0;
  let homePitcherRuns = 0;
  let awayPitcherRuns = 0;

  const pickReliever = (bullpen, currentP, isCloseLate) => {
    if (!bullpen || bullpen.length === 0) return currentP;
    if (isCloseLate) {
      // Closer is highest OVR reliever
      return bullpen[0];
    }
    const pool = bullpen.slice(1);
    if (pool.length === 0) return bullpen[0];
    return pool[Math.floor(Math.random() * pool.length)];
  };

  const simHalfInning = (battingLineup, batterIdxRef, pitchingTeamPitcher, fieldGlove, isHomeBatting, inning) => {
    let outs = 0;
    let runners = [false, false, false]; // 1B, 2B, 3B
    let runsThisInning = 0;
    let safety = 0;

    while (outs < 3 && safety < 25) {
      safety++;
      const batter = battingLineup[batterIdxRef.idx % battingLineup.length];
      batterIdxRef.idx++;
      const bStat = ensureDelta(batter);
      const pStat = ensureDelta(pitchingTeamPitcher);

      // Platoon L/R bonus
      let platoonEdge = 0;
      if (batter.bats === "S") platoonEdge = 2.5;
      else if (batter.bats !== pitchingTeamPitcher.throws) platoonEdge = 3.5;
      else platoonEdge = -2.5;

      // Pitcher ratings vs Hitter ratings
      const pitchSkill =
        pitchingTeamPitcher.velocity * 0.36 +
        pitchingTeamPitcher.control * 0.34 +
        pitchingTeamPitcher.finesse * 0.30;
      const hitSkill = batter.power * 0.45 + batter.speed * 0.25 + batter.glove * 0.1 + 15;

      const diff = (hitSkill + platoonEdge - pitchSkill) / 100; // roughly -0.5 to +0.5

      // Probabilities per PA
      const bbProb = clamp(7.5 + (60 - pitchingTeamPitcher.control) * 0.11 + diff * 4, 3, 18) / 100;
      const soProb = clamp(21.5 + (pitchingTeamPitcher.velocity * 0.55 + pitchingTeamPitcher.finesse * 0.45 - 60) * 0.18 - diff * 8, 9, 38) / 100;
      const hitProb = clamp(24.5 + diff * 13 - (fieldGlove - 60) * 0.08, 14, 36) / 100;

      const roll = Math.random();
      if (roll < bbProb) {
        // Walk
        bStat.bb++;
        pStat.bb++;
        if (runners[0] && runners[1] && runners[2]) {
          runsThisInning++;
          bStat.rbi++;
          pStat.er++;
        } else if (runners[0] && runners[1]) {
          runners[2] = true;
        } else if (runners[0]) {
          runners[1] = true;
        } else {
          runners[0] = true;
        }
      } else if (roll < bbProb + soProb) {
        // Strikeout
        bStat.ab++;
        bStat.so++;
        pStat.so++;
        pStat.ipOuts++;
        outs++;
      } else if (roll < bbProb + soProb + hitProb) {
        // Base Hit! Determine Single, Double, Triple, HR
        bStat.ab++;
        bStat.h++;
        pStat.h++;

        const hrProb = clamp(7 + (batter.power - 55) * 0.24 - (pitchingTeamPitcher.finesse - 60) * 0.08, 2, 26) / 100;
        const tripleProb = clamp(1.5 + (batter.speed - 60) * 0.06, 0.3, 6) / 100;
        const doubleProb = clamp(17 + (batter.power * 0.5 + batter.speed * 0.5 - 60) * 0.15, 8, 28) / 100;

        const hitRoll = Math.random();
        if (hitRoll < hrProb) {
          // Home Run
          bStat.hr++;
          const rbi = 1 + (runners[0] ? 1 : 0) + (runners[1] ? 1 : 0) + (runners[2] ? 1 : 0);
          runsThisInning += rbi;
          bStat.rbi += rbi;
          bStat.r++;
          pStat.er += rbi;
          runners = [false, false, false];
        } else if (hitRoll < hrProb + tripleProb) {
          bStat.triples++;
          const rbi = (runners[0] ? 1 : 0) + (runners[1] ? 1 : 0) + (runners[2] ? 1 : 0);
          runsThisInning += rbi;
          bStat.rbi += rbi;
          pStat.er += rbi;
          runners = [false, false, true];
        } else if (hitRoll < hrProb + tripleProb + doubleProb) {
          bStat.doubles++;
          let rbi = (runners[2] ? 1 : 0) + (runners[1] ? 1 : 0);
          const firstScores = runners[0] && batter.speed > 65 && Math.random() < 0.45;
          if (firstScores) rbi++;
          runsThisInning += rbi;
          bStat.rbi += rbi;
          pStat.er += rbi;
          runners = [false, true, runners[0] && !firstScores];
        } else {
          // Single
          let rbi = runners[2] ? 1 : 0;
          const secondScores = runners[1] && Math.random() < 0.55;
          if (secondScores) rbi++;
          runsThisInning += rbi;
          bStat.rbi += rbi;
          pStat.er += rbi;
          runners = [true, runners[0], runners[1] && !secondScores];
        }

        // Stolen base attempt if runner on 1B and < 2 outs
        if (runners[0] && !runners[1] && outs < 2 && batter.speed >= 68 && Math.random() < (batter.speed - 55) * 0.006) {
          if (Math.random() < 0.76) {
            bStat.sb++;
            runners[0] = false;
            runners[1] = true;
          } else {
            runners[0] = false;
            outs++;
            pStat.ipOuts++;
          }
        }
      } else {
        // Ball in play out
        bStat.ab++;
        pStat.ipOuts++;
        outs++;
        // Sac fly if runner on 3B and < 2 outs
        if (runners[2] && outs < 3 && Math.random() < 0.28) {
          runners[2] = false;
          runsThisInning++;
          bStat.rbi++;
          pStat.er++;
        }
      }
    }
    return { runs: runsThisInning, outsRecorded: outs };
  };

  const homeIdxRef = { idx: 0 };
  const awayIdxRef = { idx: 0 };

  let inning = 1;
  while (inning <= 15) {
    // Top of inning: Away bats vs Home pitcher
    if (homePitcher === homeSP && (homePitcherOuts >= 18 || homePitcherRuns >= 5 || inning >= 7)) {
      homePitcher = pickReliever(homeSetup.bullpen, homePitcher, inning >= 9 && Math.abs(homeRuns - awayRuns) <= 3);
      ensureDelta(homePitcher).g = 1;
    } else if (homePitcher !== homeSP && inning >= 9 && Math.abs(homeRuns - awayRuns) <= 3) {
      homePitcher = pickReliever(homeSetup.bullpen, homePitcher, true);
      ensureDelta(homePitcher).g = 1;
    }

    const topRes = simHalfInning(awaySetup.lineup, awayIdxRef, homePitcher, homeGlove, false, inning);
    awayRuns += topRes.runs;
    if (homePitcher === homeSP) {
      homePitcherOuts += topRes.outsRecorded;
      homePitcherRuns += topRes.runs;
    }

    // Check if bottom of 9th+ is unnecessary
    if (inning >= 9 && homeRuns > awayRuns) {
      break;
    }

    // Bottom of inning: Home bats vs Away pitcher
    if (awayPitcher === awaySP && (awayPitcherOuts >= 18 || awayPitcherRuns >= 5 || inning >= 7)) {
      awayPitcher = pickReliever(awaySetup.bullpen, awayPitcher, inning >= 9 && Math.abs(homeRuns - awayRuns) <= 3);
      ensureDelta(awayPitcher).g = 1;
    } else if (awayPitcher !== awaySP && inning >= 9 && Math.abs(homeRuns - awayRuns) <= 3) {
      awayPitcher = pickReliever(awaySetup.bullpen, awayPitcher, true);
      ensureDelta(awayPitcher).g = 1;
    }

    const botRes = simHalfInning(homeSetup.lineup, homeIdxRef, awayPitcher, awayGlove, true, inning);
    homeRuns += botRes.runs;
    if (awayPitcher === awaySP) {
      awayPitcherOuts += botRes.outsRecorded;
      awayPitcherRuns += botRes.runs;
    }

    if (inning >= 9 && homeRuns !== awayRuns) {
      break;
    }
    inning++;
  }

  // Tie-breaker safety if 15 innings ended tied
  if (homeRuns === awayRuns) {
    if (Math.random() < 0.52) homeRuns++;
    else awayRuns++;
  }

  const homeWon = homeRuns > awayRuns;

  // Assign W / L / SV
  if (homeWon) {
    ensureDelta(homeSP).w = 1;
    ensureDelta(awaySP).l = 1;
    if (homePitcher && homePitcher.id !== homeSP.id && homeRuns - awayRuns <= 3) {
      ensureDelta(homePitcher).sv = 1;
    }
  } else {
    ensureDelta(awaySP).w = 1;
    ensureDelta(homeSP).l = 1;
    if (awayPitcher && awayPitcher.id !== awaySP.id && awayRuns - homeRuns <= 3) {
      ensureDelta(awayPitcher).sv = 1;
    }
  }

  return {
    homeTeamId: homeTeam.id,
    awayTeamId: awayTeam.id,
    homeRuns,
    awayRuns,
    homeWon,
    statDeltas,
  };
}

