function randGaussian(mean, stdDev) {
  let u = 0, v = 0;
  while (u === 0) u = Math.random();
  while (v === 0) v = Math.random();
  const num = Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
  return num * stdDev + mean;
}

function calculateOverall(player) {
  if (player.isPitcher) {
    // Velocity, Control, Finesse
    const raw = player.velocity * 0.36 + player.control * 0.34 + player.finesse * 0.30;
    return clamp(raw, 20, 99);
  } else {
    // Power, Speed, Glove (weighted by position)
    const pos = player.position;
    let wPow = 0.40, wSpd = 0.30, wGlv = 0.30;
    if (pos === "DH" || pos === "1B") { wPow = 0.55; wSpd = 0.20; wGlv = 0.25; }
    else if (pos === "C" || pos === "SS" || pos === "CF") { wPow = 0.32; wSpd = 0.30; wGlv = 0.38; }
    const raw = player.power * wPow + player.speed * wSpd + player.glove * wGlv;
    return clamp(raw, 20, 99);
  }
}

