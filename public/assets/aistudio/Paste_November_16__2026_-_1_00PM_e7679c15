function formatIP(ipOuts) {
  const full = Math.floor(ipOuts / 3);
  const rem = ipOuts % 3;
  return `${full}.${rem}`;
}

function getHitterSlash(s) {
  const avg = s.ab > 0 ? s.h / s.ab : 0;
  const pa = s.ab + s.bb;
  const obp = pa > 0 ? (s.h + s.bb) / pa : 0;
  const singles = s.h - s.doubles - s.triples - s.hr;
  const tb = singles + s.doubles * 2 + s.triples * 3 + s.hr * 4;
  const slg = s.ab > 0 ? tb / s.ab : 0;
  return {
    avg: avg.toFixed(3).replace(/^0/, ""),
    obp: obp.toFixed(3).replace(/^0/, ""),
    slg: slg.toFixed(3).replace(/^0/, ""),
    ops: (obp + slg).toFixed(3).replace(/^0/, ""),
    rawOps: obp + slg,
  };
}

function getPitcherRatios(s) {
  const ip = s.ipOuts / 3;
  const era = ip > 0 ? (s.er * 9) / ip : 0;
  const whip = ip > 0 ? (s.h + s.bb) / ip : 0;
  return {
    ipStr: formatIP(s.ipOuts),
    era: era.toFixed(2),
    whip: whip.toFixed(2),
    rawEra: ip > 0 ? era : 99.99,
  };
}

function getRatingColor(val) {
  if (val >= 85) return "bg-emerald-500/20 text-emerald-300 border-emerald-500/40";
  if (val >= 75) return "bg-sky-500/20 text-sky-300 border-sky-500/40";
  if (val >= 65) return "bg-indigo-500/20 text-indigo-300 border-indigo-500/40";
  if (val >= 52) return "bg-slate-700/60 text-slate-200 border-slate-600/50";
  return "bg-amber-500/15 text-amber-300 border-amber-500/30";
}

function getPlayerTradeValue(player) {
  // Value scale roughly 50 to 1200
  const ovrFactor = Math.pow(Math.max(30, player.ovr) - 25, 2.05);
  const potBonus = Math.max(0, player.potential - player.ovr) * (player.age <= 24 ? 9 : 3);
  let ageMult = 1.0;
  if (player.age <= 23) ageMult = 1.28;
  else if (player.age <= 27) ageMult = 1.15;
  else if (player.age <= 30) ageMult = 0.95;
  else if (player.age <= 33) ageMult = 0.72;
  else ageMult = 0.48;

  return Math.round((ovrFactor * 0.45 + potBonus) * ageMult);
}

function getDraftPickTradeValue(pick, teams, currentYear) {
  const origTeam = teams.find((t) => t.id === pick.originalTeamId);
  // Estimate pick slot from current standings (worse record = higher pick value)
  const sorted = [...teams].sort((a, b) => {
    const pctA = a.wins + a.losses > 0 ? a.wins / (a.wins + a.losses) : 0.5;
    const pctB = b.wins + b.losses > 0 ? b.wins / (b.wins + b.losses) : 0.5;
    return pctA - pctB;
  });
  const slot = Math.max(1, sorted.findIndex((t) => t.id === pick.originalTeamId) + 1); // 1 = worst team, 32 = best
  const roundBase = [0, 420, 230, 130, 75, 45][pick.round] || 30;
  const slotMult = 1.35 - (slot / 32) * 0.65; // #1 pick gets 1.33x, #32 gets 0.70x
  const yearDiscount = Math.pow(0.86, Math.max(0, pick.year - currentYear - 1));
  return Math.round(roundBase * slotMult * yearDiscount);
}

// Determine AI positional needs when drafting
function getTeamRosterNeeds(roster) {
  const counts = { C: 0, "1B": 0, "2B": 0, "3B": 0, SS: 0, LF: 0, CF: 0, RF: 0, DH: 0, SP: 0, RP: 0 };
  roster.forEach((p) => { counts[p.position] = (counts[p.position] || 0) + 1; });
  const totalHitters = roster.filter((p) => !p.isPitcher).length;
  const totalPitchers = roster.filter((p) => p.isPitcher).length;
  return { counts, totalHitters, totalPitchers };
}

function selectBestDraftPickForAI(availablePlayers, teamRoster) {
  const { counts, totalHitters, totalPitchers } = getTeamRosterNeeds(teamRoster);
  const topCandidates = availablePlayers.slice(0, 28);
  let bestPlayer = topCandidates[0];
  let bestScore = -9999;

  for (const p of topCandidates) {
    let score = p.ovr * 1.6 + (p.potential - p.ovr) * 0.45 - Math.max(0, p.age - 28) * 1.5;

    // Positional balancing for 30-man roster (target ~16 hitters, ~14 pitchers)
    if (p.isPitcher) {
      if (totalPitchers >= 15) score -= 45;
      else if (totalPitchers < 13 && teamRoster.length > 22) score += 18;
      if (p.position === "SP" && counts.SP < 6) score += 12;
      if (p.position === "RP" && counts.RP < 7) score += 10;
    } else {
      if (totalHitters >= 17) score -= 45;
      else if (totalHitters < 15 && teamRoster.length > 22) score += 18;
      if ((counts[p.position] || 0) === 0) score += 16;
      else if ((counts[p.position] || 0) === 1 && p.position !== "DH") score += 6;
      else if ((counts[p.position] || 0) >= 3) score -= 22;
    }

    // Slight randomness so AI GMs behave uniquely
    score += (Math.random() - 0.5) * 6;
    if (score > bestScore) {
      bestScore = score;
      bestPlayer = p;
    }
  }
  return bestPlayer;
}

