                    <td className="py-2 px-3 text-left font-sans text-slate-400">Career Totals</td>
                    <td className="px-2">{player.careerStats.g + player.seasonStats.g}</td>
                    <td className="px-2">{player.careerStats.ab + player.seasonStats.ab}</td>
                    <td className="px-2">{player.careerStats.h + player.seasonStats.h}</td>
                    <td className="px-2">{player.careerStats.hr + player.seasonStats.hr}</td>
                    <td className="px-2">{player.careerStats.rbi + player.seasonStats.rbi}</td>
                    <td className="px-2">{player.careerStats.sb + player.seasonStats.sb}</td>
                    <td className="px-2">
                      {getHitterSlash({
                        ab: player.careerStats.ab + player.seasonStats.ab,
                        h: player.careerStats.h + player.seasonStats.h,
                        bb: player.careerStats.bb + player.seasonStats.bb,
                        doubles: player.careerStats.doubles + player.seasonStats.doubles,
                        triples: player.careerStats.triples + player.seasonStats.triples,
                        hr: player.careerStats.hr + player.seasonStats.hr,
                      }).avg}
                    </td>
                    <td className="px-2">
                      {getHitterSlash({
                        ab: player.careerStats.ab + player.seasonStats.ab,
                        h: player.careerStats.h + player.seasonStats.h,
                        bb: player.careerStats.bb + player.seasonStats.bb,
                        doubles: player.careerStats.doubles + player.seasonStats.doubles,
                        triples: player.careerStats.triples + player.seasonStats.triples,
                        hr: player.careerStats.hr + player.seasonStats.hr,
                      }).obp}
                    </td>
                    <td className="px-3">
                      {getHitterSlash({
                        ab: player.careerStats.ab + player.seasonStats.ab,
                        h: player.careerStats.h + player.seasonStats.h,
                        bb: player.careerStats.bb + player.seasonStats.bb,
                        doubles: player.careerStats.doubles + player.seasonStats.doubles,
                        triples: player.careerStats.triples + player.seasonStats.triples,
                        hr: player.careerStats.hr + player.seasonStats.hr,
                      }).slg}
                    </td>
                  </tr>
                </tbody>
              </table>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

// ============================================================================
// 6. MAIN APPLICATION COMPONENT
// ============================================================================

export default function App() {
  // Game Lifecycle States: "SETUP" | "INAUGURAL_DRAFT" | "REGULAR_SEASON" | "PLAYOFFS_COMPLETE" | "ROOKIE_DRAFT" | "ROSTER_CUTS"
  const [phase, setPhase] = useState("SETUP");
  const [year, setYear] = useState(2026);
  const [userTeamId, setUserTeamId] = useState("NYY");

  // Core League Data
  const [teams, setTeams] = useState([]);
  const [players, setPlayers] = useState([]); // All players in universe (teamId = string or null for waiver)
  const [draftPicks, setDraftPicks] = useState([]);
  const [schedule, setSchedule] = useState([]);
  const [currentDay, setCurrentDay] = useState(0); // 0 to 162

  // Draft Room State
  const [draftOrder, setDraftOrder] = useState([]); // Array of { pickNum, round, teamId, originalTeamId, pickId? }
  const [currentPickIdx, setCurrentPickIdx] = useState(0);
  const [draftPool, setDraftPool] = useState([]); // Undrafted players in active draft
  const [draftHistory, setDraftHistory] = useState([]);

  // Playoff & History State
  const [playoffResults, setPlayoffResults] = useState(null);
  const [championsHistory, setChampionsHistory] = useState([]);
  const [transactions, setTransactions] = useState([]);
  const [recentGames, setRecentGames] = useState([]);

  // UI Navigation & Filters
  const [activeTab, setActiveTab] = useState("dashboard");
  const [selectedPlayer, setSelectedPlayer] = useState(null);
  const [toastMsg, setToastMsg] = useState(null);

  const showToast = useCallback((text, type = "info") => {
    setToastMsg({ text, type, id: Date.now() });
  }, []);

  useEffect(() => {
    if (!toastMsg) return;
    const t = setTimeout(() => setToastMsg(null), 4000);
    return () => clearTimeout(t);
  }, [toastMsg]);

  const addTransaction = useCallback((category, summary) => {
    setTransactions((prev) => [
      { id: `${Date.now()}-${Math.random()}`, year, day: currentDay, category, summary },
      ...prev.slice(0, 149),
    ]);
  }, [year, currentDay]);

  // Derived Lookups
  const teamMap = useMemo(() => {
    const map = {};
    teams.forEach((t) => { map[t.id] = t; });
    return map;
  }, [teams]);

  const userTeam = teamMap[userTeamId];

  const playersByTeam = useMemo(() => {
    const map = {};
    teams.forEach((t) => { map[t.id] = []; });
    const waivers = [];
    players.forEach((p) => {
      if (p.teamId && map[p.teamId]) map[p.teamId].push(p);
      else waivers.push(p);
    });
    Object.keys(map).forEach((tid) => map[tid].sort((a, b) => b.ovr - a.ovr));
    waivers.sort((a, b) => b.ovr - a.ovr);
    return { byTeam: map, waivers };
  }, [players, teams]);

  // ==========================================================================
  // GAME INITIALIZATION & INAUGURAL FANTASY DRAFT
  // ==========================================================================

  const startNewFranchise = (chosenTeamId) => {
    globalPlayerCounter = 1;
    const { teams: initTeams, draftPicks: initPicks } = createInitialLeague(2026);
    const pool = generateInitialPlayerPool();
    const sched = generateSeasonSchedule(initTeams);

    // Randomize 32-team order for Inaugural 30-Round Snake Draft
    const shuffledTeamIds = [...initTeams.map((t) => t.id)].sort(() => Math.random() - 0.5);
    const order = [];
    let pickCounter = 1;
    for (let r = 1; r <= 30; r++) {
      const roundOrder = r % 2 === 1 ? shuffledTeamIds : [...shuffledTeamIds].reverse();
      for (const tid of roundOrder) {
        order.push({
          pickNum: pickCounter++,
          round: r,
          teamId: tid,
          originalTeamId: tid,
        });
      }
    }

    setUserTeamId(chosenTeamId);
    setYear(2026);
    setTeams(initTeams);
    setDraftPicks(initPicks);
    setSchedule(sched);
    setCurrentDay(0);
    setPlayers([]);
    setDraftPool(pool);
    setDraftOrder(order);
    setCurrentPickIdx(0);
    setDraftHistory([]);
    setPlayoffResults(null);
    setChampionsHistory([]);
    setRecentGames([]);
    setTransactions([
      {
        id: "init-1",
        year: 2026,
        day: 0,
        category: "LEAGUE",
        summary: `2026 Inaugural Fantasy Draft initialized with 1,344 players across 32 franchises.`,
      },
    ]);
    setPhase("INAUGURAL_DRAFT");
    setActiveTab("draft");
  };

  // Draft Execution Helpers
  const executeSingleDraftPick = useCallback((chosenPlayerId, currentIdx, currentPool, currentPlayers) => {
    const slot = draftOrder[currentIdx];
    if (!slot) return null;

    const teamRoster = currentPlayers.filter((p) => p.teamId === slot.teamId);
    let pickedPlayer = chosenPlayerId
      ? currentPool.find((p) => p.id === chosenPlayerId)
      : selectBestDraftPickForAI(currentPool, teamRoster);

    if (!pickedPlayer) pickedPlayer = currentPool[0];

    const updatedPlayer = { ...pickedPlayer, teamId: slot.teamId };
    const nextPool = currentPool.filter((p) => p.id !== pickedPlayer.id);
    const nextPlayers = [...currentPlayers, updatedPlayer];
    const historyEntry = {
      ...slot,
      player: updatedPlayer,
    };

    return {
      nextIdx: currentIdx + 1,
      nextPool,
      nextPlayers,
      historyEntry,
    };
  }, [draftOrder]);

  const finishActiveDraft = useCallback((finalPlayers, remainingPool, isRookie) => {
    // Remaining pool players automatically enter the Waiver Wire (teamId: null)
    const waiverPlayers = remainingPool.map((p) => ({ ...p, teamId: null }));
    const mergedPlayers = [...finalPlayers, ...waiverPlayers];
    setPlayers(mergedPlayers);
    setDraftPool([]);

    if (!isRookie) {
      setPhase("REGULAR_SEASON");
      setActiveTab("dashboard");
      addTransaction("DRAFT", `Inaugural 30-Round Draft complete! 960 players drafted; ${waiverPlayers.length} placed on Waiver Wire.`);
      showToast("Inaugural Draft Complete! Opening Day is ready.", "success");
    } else {
      // Check if any team exceeds 30 players (teams normally have 30 + 5 rookies = 35, need to trim back to 30)
      // AI teams automatically trim down to their best 30 players, sending excess to waivers
      const trimmedPlayers = [];
      const userRoster = [];
      const byT = {};
      mergedPlayers.forEach((p) => {
        if (!p.teamId) {
          trimmedPlayers.push(p);
        } else {
          if (!byT[p.teamId]) byT[p.teamId] = [];
          byT[p.teamId].push(p);
        }
      });

      Object.entries(byT).forEach(([tid, roster]) => {
        if (tid === userTeamId) {
          userRoster.push(...roster);
        } else {
          // AI keeps top 30 balancing pitchers & hitters
          roster.sort((a, b) => (b.ovr + (b.age <= 22 ? 6 : 0)) - (a.ovr + (a.age <= 22 ? 6 : 0)));
          const keep = roster.slice(0, 30);
          const cut = roster.slice(30).map((p) => ({ ...p, teamId: null }));
          trimmedPlayers.push(...keep, ...cut);
        }
      });

      setPlayers([...trimmedPlayers, ...userRoster]);
      addTransaction("DRAFT", `${year} Rookie Draft concluded! Remaining prospects added to Waiver Pool.`);

      if (userRoster.length > 30) {
        setPhase("ROSTER_CUTS");
        setActiveTab("roster");
        showToast(`Rookie Draft complete! Trim your roster from ${userRoster.length} down to 30 players.`, "warning");
      } else {
        setPhase("REGULAR_SEASON");
        setActiveTab("dashboard");
        showToast(`${year} Regular Season is ready!`, "success");
      }
    }
  }, [addTransaction, showToast, userTeamId, year]);

  const handleUserDraftSelect = (playerId) => {
    const slot = draftOrder[currentPickIdx];
    if (!slot || slot.teamId !== userTeamId) return;

    const res = executeSingleDraftPick(playerId, currentPickIdx, draftPool, players);
    if (!res) return;

    setDraftHistory((prev) => [res.historyEntry, ...prev]);
    if (res.nextIdx >= draftOrder.length) {
      finishActiveDraft(res.nextPlayers, res.nextPool, phase === "ROOKIE_DRAFT");
    } else {
      setCurrentPickIdx(res.nextIdx);
      setDraftPool(res.nextPool);
      setPlayers(res.nextPlayers);
    }
  };

  const handleSimNextPick = () => {
    if (currentPickIdx >= draftOrder.length) return;
    const res = executeSingleDraftPick(null, currentPickIdx, draftPool, players);
    if (!res) return;

    setDraftHistory((prev) => [res.historyEntry, ...prev]);
    if (res.nextIdx >= draftOrder.length) {
      finishActiveDraft(res.nextPlayers, res.nextPool, phase === "ROOKIE_DRAFT");
    } else {
      setCurrentPickIdx(res.nextIdx);
      setDraftPool(res.nextPool);
      setPlayers(res.nextPlayers);
    }
  };

  const handleSimToUserTurn = () => {
    let idx = currentPickIdx;
    let pool = draftPool;
    let plrs = players;
    const newHist = [];

    // If currently user's turn, advance at least 1 pick first
    if (idx < draftOrder.length && draftOrder[idx].teamId === userTeamId) {
      const first = executeSingleDraftPick(null, idx, pool, plrs);
      idx = first.nextIdx;
      pool = first.nextPool;
      plrs = first.nextPlayers;
      newHist.unshift(first.historyEntry);
    }

    while (idx < draftOrder.length && draftOrder[idx].teamId !== userTeamId) {
      const step = executeSingleDraftPick(null, idx, pool, plrs);
      idx = step.nextIdx;
      pool = step.nextPool;
      plrs = step.nextPlayers;
      newHist.unshift(step.historyEntry);
    }

    setDraftHistory((prev) => [...newHist, ...prev]);
    if (idx >= draftOrder.length) {
      finishActiveDraft(plrs, pool, phase === "ROOKIE_DRAFT");
    } else {
      setCurrentPickIdx(idx);
      setDraftPool(pool);
      setPlayers(plrs);
    }
  };

  const handleAutoDraftAll = () => {
    let idx = currentPickIdx;
    let pool = draftPool;
    let plrs = players;
    const newHist = [];

    while (idx < draftOrder.length) {
      const step = executeSingleDraftPick(null, idx, pool, plrs);
      idx = step.nextIdx;
      pool = step.nextPool;
      plrs = step.nextPlayers;
      newHist.unshift(step.historyEntry);
    }

    setDraftHistory((prev) => [...newHist, ...prev]);
    finishActiveDraft(plrs, pool, phase === "ROOKIE_DRAFT");
  };

  // ==========================================================================
  // REGULAR SEASON SIMULATION & AI ROSTER MOVES
  // ==========================================================================

  const simulateDays = (numDays) => {
    if (phase !== "REGULAR_SEASON" || currentDay >= 162) return;

    const targetDay = Math.min(162, currentDay + numDays);
    let workingTeams = teams.map((t) => ({ ...t }));
    let workingPlayers = players.map((p) => ({
      ...p,
      seasonStats: { ...p.seasonStats },
    }));

    const tLookup = {};
    workingTeams.forEach((t) => { tLookup[t.id] = t; });

    const pLookup = {};
    const rosterLookup = {};
    workingTeams.forEach((t) => { rosterLookup[t.id] = []; });
    workingPlayers.forEach((p) => {
      pLookup[p.id] = p;
      if (p.teamId && rosterLookup[p.teamId]) {
        rosterLookup[p.teamId].push(p);
      }
    });

    const userRecent = [];
    const aiLogs = [];

    for (let d = currentDay; d < targetDay; d++) {
      const matchups = schedule[d] || [];
      for (const [homeId, awayId] of matchups) {
        const homeT = tLookup[homeId];
        const awayT = tLookup[awayId];
        const res = simulateSingleGame(homeT, awayT, rosterLookup[homeId], rosterLookup[awayId], d);

        homeT.runsScored += res.homeRuns;
        homeT.runsAllowed += res.awayRuns;
        awayT.runsScored += res.awayRuns;
        awayT.runsAllowed += res.homeRuns;

        if (res.homeWon) {
          homeT.wins++;
          awayT.losses++;
          homeT.streak = homeT.streak >= 0 ? homeT.streak + 1 : 1;
          awayT.streak = awayT.streak <= 0 ? awayT.streak - 1 : -1;
          homeT.last10 = [...homeT.last10.slice(-9), "W"];
          awayT.last10 = [...awayT.last10.slice(-9), "L"];
        } else {
          awayT.wins++;
          homeT.losses++;
          awayT.streak = awayT.streak >= 0 ? awayT.streak + 1 : 1;
          homeT.streak = homeT.streak <= 0 ? homeT.streak - 1 : -1;
          awayT.last10 = [...awayT.last10.slice(-9), "W"];
          homeT.last10 = [...homeT.last10.slice(-9), "L"];
        }

        if (homeId === userTeamId || awayId === userTeamId) {
          userRecent.unshift({
            day: d + 1,
            homeId,
            awayId,
            homeRuns: res.homeRuns,
            awayRuns: res.awayRuns,
            userWon: (homeId === userTeamId && res.homeWon) || (awayId === userTeamId && !res.homeWon),
          });
        }

        // Apply player box-score deltas
        for (const [pid, delta] of Object.entries(res.statDeltas)) {
          const plr = pLookup[pid];
          if (!plr) continue;
          const s = plr.seasonStats;
          for (const k of Object.keys(delta)) {
            s[k] = (s[k] || 0) + delta[k];
          }
        }
      }

      // Occasional AI Waiver Claim (every ~12 days)
      if (d > 10 && d < 145 && d % 12 === 0) {
        const waivers = workingPlayers.filter((p) => !p.teamId).sort((a, b) => b.ovr - a.ovr);
        if (waivers.length > 0) {
          const aiTeams = workingTeams.filter((t) => t.id !== userTeamId);
          const randomAI = aiTeams[Math.floor(Math.random() * aiTeams.length)];
          const aiRoster = rosterLookup[randomAI.id].sort((a, b) => a.ovr - b.ovr);
          const topFA = waivers[0];
          const weakest = aiRoster[0];
          if (topFA && weakest && topFA.ovr > weakest.ovr + 4) {
            topFA.teamId = randomAI.id;
            weakest.teamId = null;
            rosterLookup[randomAI.id] = [...aiRoster.slice(1), topFA];
            aiLogs.push({
              id: `ai-w-${d}-${randomAI.id}`,
              year,
              day: d + 1,
              category: "WAIVER",
              summary: `${randomAI.city} ${randomAI.name} claimed ${topFA.position} ${topFA.name} (${topFA.ovr} OVR) and waived ${weakest.name} (${weakest.ovr} OVR).`,
            });
          }
        }
      }

      // Occasional CPU-to-CPU Trade before Trade Deadline (Day 115)
      if (d > 30 && d < 115 && d % 25 === 0) {
        const aiTeams = workingTeams.filter((t) => t.id !== userTeamId);
        const t1 = aiTeams[Math.floor(Math.random() * aiTeams.length)];
        const t2 = aiTeams.find((t) => t.id !== t1.id && t.league !== t1.league);
        if (t1 && t2) {
          const r1 = rosterLookup[t1.id].sort((a, b) => b.ovr - a.ovr);
          const r2 = rosterLookup[t2.id].sort((a, b) => b.ovr - a.ovr);
          const p1 = r1[Math.floor(Math.random() * 8) + 4];
          const p2 = r2.find((p) => p.id !== p1?.id && Math.abs(getPlayerTradeValue(p) - getPlayerTradeValue(p1)) < 85);
          if (p1 && p2) {
            p1.teamId = t2.id;
            p2.teamId = t1.id;
            rosterLookup[t1.id] = rosterLookup[t1.id].filter((p) => p.id !== p1.id).concat(p2);
            rosterLookup[t2.id] = rosterLookup[t2.id].filter((p) => p.id !== p2.id).concat(p1);
            aiLogs.push({
              id: `ai-tr-${d}-${t1.id}`,
              year,
              day: d + 1,
              category: "TRADE",
              summary: `TRADE: ${t1.id} acquires ${p2.position} ${p2.name} (${p2.ovr}) from ${t2.id} in exchange for ${p1.position} ${p1.name} (${p1.ovr}).`,
            });
          }
        }
      }
    }

    setTeams(workingTeams);
    setPlayers(workingPlayers);
    setCurrentDay(targetDay);
    if (userRecent.length > 0) {
      setRecentGames((prev) => [...userRecent, ...prev].slice(0, 30));
    }
    if (aiLogs.length > 0) {
      setTransactions((prev) => [...aiLogs, ...prev].slice(0, 150));
    }

    if (targetDay >= 162) {
      // Automatically run Playoffs upon finishing Game 162
      const pResults = simulatePlayoffs(workingTeams, rosterLookup);
      setPlayoffResults(pResults);
      setTeams((prev) =>
        prev.map((t) => (t.id === pResults.champion.id ? { ...t, championships: t.championships + 1 } : t))
      );
      setChampionsHistory((prev) => [
        { year, champion: pResults.champion, runnerUp: pResults.runnerUp, score: pResults.rounds.worldSeries.score },
        ...prev,
      ]);
      setPhase("PLAYOFFS_COMPLETE");
      addTransaction("PLAYOFFS", `${year} World Series: ${pResults.champion.city} ${pResults.champion.name} defeated ${pResults.runnerUp.city} ${pResults.runnerUp.name} (${pResults.rounds.worldSeries.score})!`);
      showToast(`${year} Regular Season & Playoffs Complete!`, "success");
    }
  };

  // ==========================================================================
  // OFFSEASON PROGRESSION & ANNUAL ROOKIE DRAFT TRANSITION
  // ==========================================================================

  const advanceToOffseasonRookieDraft = () => {
    const nextYear = year + 1;

    // 1. Roll season stats into career stats, age +1 year, apply progression/regression & retirements
    const updatedPlayers = [];
    let retiredCount = 0;

    for (const p of players) {
      const mergedCareer = {};
      for (const k of Object.keys(p.careerStats)) {
        mergedCareer[k] = (p.careerStats[k] || 0) + (p.seasonStats[k] || 0);
      }

      const nextAge = p.age + 1;
      // Retirement check for older players
      if (nextAge >= 36 && Math.random() < (nextAge - 34) * 0.22) {
        retiredCount++;
        continue;
      }

      let delta = 0;
      if (nextAge <= 24) {
        delta = Math.round(Math.random() * 4 + (p.potential > p.ovr ? 2 : 0));
      } else if (nextAge <= 29) {
        delta = Math.round((Math.random() - 0.35) * 3);
      } else if (nextAge <= 33) {
        delta = -Math.round(Math.random() * 3);
      } else {
        delta = -Math.round(Math.random() * 4 + 1);
      }

      const agedPlayer = {
        ...p,
        age: nextAge,
        careerStats: mergedCareer,
        seasonStats: createEmptySeasonStats(p.isPitcher),
      };

      if (agedPlayer.isPitcher) {
        agedPlayer.velocity = clamp(agedPlayer.velocity + delta + Math.round((Math.random() - 0.5) * 2), 20, 99);
        agedPlayer.control = clamp(agedPlayer.control + delta + Math.round((Math.random() - 0.5) * 2), 20, 99);
        agedPlayer.finesse = clamp(agedPlayer.finesse + delta + Math.round((Math.random() - 0.5) * 2), 20, 99);
      } else {
        agedPlayer.power = clamp(agedPlayer.power + delta + Math.round((Math.random() - 0.5) * 2), 20, 99);
        agedPlayer.speed = clamp(agedPlayer.speed + (nextAge > 29 ? delta - 1 : delta), 20, 99);
        agedPlayer.glove = clamp(agedPlayer.glove + delta + Math.round((Math.random() - 0.5) * 2), 20, 99);
      }
      agedPlayer.ovr = calculateOverall(agedPlayer);
      updatedPlayers.push(agedPlayer);
    }

    // 2. Sort teams in STRICT REVERSE STANDINGS ORDER (Worst record picks #1, Best record picks #32)
    const reverseStandings = [...teams].sort((a, b) => {
      if (a.wins !== b.wins) return a.wins - b.wins;
      return (a.runsScored - a.runsAllowed) - (b.runsScored - b.runsAllowed);
    });

    const slotByOrigTeam = {};
    reverseStandings.forEach((t, idx) => { slotByOrigTeam[t.id] = idx + 1; });

    // 3. Build 5-round Rookie Draft order using traded draft picks for `nextYear`
    const yearPicks = draftPicks.filter((pk) => pk.year === nextYear);
    const orderedRookiePicks = [];
    for (let r = 1; r <= 5; r++) {
      const roundPicks = yearPicks
        .filter((pk) => pk.round === r)
        .sort((a, b) => (slotByOrigTeam[a.originalTeamId] || 16) - (slotByOrigTeam[b.originalTeamId] || 16));

      roundPicks.forEach((pk, idx) => {
        orderedRookiePicks.push({
          pickNum: (r - 1) * 32 + idx + 1,
          round: r,
          teamId: pk.ownerTeamId,
          originalTeamId: pk.originalTeamId,
          pickId: pk.id,
        });
      });
    }

    // 4. Generate 160 new Rookie Prospects (5 per team x 32)
    const rookieClass = generateRookieClass(nextYear);

    // 5. Reset team W-L records for new season and roll forward future draft picks (+1 year)
    const resetTeams = teams.map((t) => ({
      ...t,
      wins: 0,
      losses: 0,
      runsScored: 0,
      runsAllowed: 0,
      streak: 0,
      last10: [],
    }));

    const newFutureYear = nextYear + 3;
    const addedFuturePicks = [];
    for (let r = 1; r <= 5; r++) {
      for (const t of resetTeams) {
        addedFuturePicks.push({
          id: `PICK-${newFutureYear}-R${r}-${t.id}`,
          year: newFutureYear,
          round: r,
          originalTeamId: t.id,
          ownerTeamId: t.id,
        });
      }
    }

    setYear(nextYear);
    setTeams(resetTeams);
    setPlayers(updatedPlayers);
    setDraftPicks((prev) => [...prev.filter((pk) => pk.year > nextYear), ...addedFuturePicks]);
    setSchedule(generateSeasonSchedule(resetTeams));
    setCurrentDay(0);
    setPlayoffResults(null);
    setRecentGames([]);
    setDraftOrder(orderedRookiePicks);
    setCurrentPickIdx(0);
    setDraftPool(rookieClass);
    setDraftHistory([]);
    setPhase("ROOKIE_DRAFT");
    setActiveTab("draft");
    addTransaction("OFFSEASON", `Offseason ${nextYear}: ${retiredCount} veterans retired. Reverse-standings 5-round Rookie Draft underway (#1 pick: ${orderedRookiePicks[0]?.teamId}).`);
    showToast(`Welcome to the ${nextYear} Offseason & Rookie Draft!`, "info");
  };

  // ==========================================================================
  // WAIVER WIRE & ROSTER CUTS HANDLERS
  // ==========================================================================

  const handleWaiverClaimAndDrop = (claimPlayerId, dropPlayerId) => {
    const userRoster = playersByTeam.byTeam[userTeamId] || [];
    const claimPlr = players.find((p) => p.id === claimPlayerId && !p.teamId);
    if (!claimPlr) return;

    if (userRoster.length >= 30 && !dropPlayerId) {
      showToast("Your 30-man roster is full. Select a player to release.", "error");
      return;
    }

    const dropPlr = dropPlayerId ? players.find((p) => p.id === dropPlayerId && p.teamId === userTeamId) : null;

    setPlayers((prev) =>
      prev.map((p) => {
        if (p.id === claimPlayerId) return { ...p, teamId: userTeamId };
        if (dropPlr && p.id === dropPlr.id) return { ...p, teamId: null };
        return p;
      })
    );

    const msg = dropPlr
      ? `${userTeamId} claimed ${claimPlr.position} ${claimPlr.name} (${claimPlr.ovr}) from waivers and released ${dropPlr.name} (${dropPlr.ovr}).`
      : `${userTeamId} signed ${claimPlr.position} ${claimPlr.name} (${claimPlr.ovr}) from waivers.`;
    addTransaction("WAIVER", msg);
    showToast(msg, "success");
  };

  const handleReleasePlayer = (dropPlayerId) => {
    const dropPlr = players.find((p) => p.id === dropPlayerId && p.teamId === userTeamId);
    if (!dropPlr) return;
    setPlayers((prev) => prev.map((p) => (p.id === dropPlayerId ? { ...p, teamId: null } : p)));
    addTransaction("WAIVER", `${userTeamId} released ${dropPlr.position} ${dropPlr.name} (${dropPlr.ovr}) to the Waiver Pool.`);
    showToast(`Released ${dropPlr.name} to waivers.`, "info");
  };

  const confirmRosterCutsComplete = () => {
    const userRoster = playersByTeam.byTeam[userTeamId] || [];
    if (userRoster.length > 30) {
      showToast(`You must trim ${userRoster.length - 30} more player(s) to reach the 30-man limit.`, "error");
      return;
    }
    setPhase("REGULAR_SEASON");
    setActiveTab("dashboard");
    showToast(`30-man roster finalized for ${year}!`, "success");
  };

  // ==========================================================================
  // TRADE EXECUTION HANDLER
  // ==========================================================================

  const executeTrade = (partnerTeamId, userPlayerIds, userPickIds, aiPlayerIds, aiPickIds) => {
    const userRoster = playersByTeam.byTeam[userTeamId] || [];
    const aiRoster = playersByTeam.byTeam[partnerTeamId] || [];

    const newUserCount = userRoster.length - userPlayerIds.length + aiPlayerIds.length;
    const newAiCount = aiRoster.length - aiPlayerIds.length + userPlayerIds.length;

    if (newUserCount > 30 || newAiCount > 30) {
      showToast(`Trade violates 30-man roster limit (Resulting sizes: You ${newUserCount}, ${partnerTeamId} ${newAiCount}). Balance player counts or waive someone first.`, "error");
      return false;
    }

    setPlayers((prev) =>
      prev.map((p) => {
        if (userPlayerIds.includes(p.id)) return { ...p, teamId: partnerTeamId };
        if (aiPlayerIds.includes(p.id)) return { ...p, teamId: userTeamId };
        return p;
      })
    );

    setDraftPicks((prev) =>
      prev.map((pk) => {
        if (userPickIds.includes(pk.id)) return { ...pk, ownerTeamId: partnerTeamId };
        if (aiPickIds.includes(pk.id)) return { ...pk, ownerTeamId: userTeamId };
        return pk;
      })
    );

    const uAssets = [
      ...userPlayerIds.map((id) => players.find((p) => p.id === id)?.name),
      ...userPickIds.map((id) => {
        const pk = draftPicks.find((x) => x.id === id);
        return pk ? `${pk.year} Rd ${pk.round} (${pk.originalTeamId})` : "";
      }),
    ].filter(Boolean);

    const aAssets = [
      ...aiPlayerIds.map((id) => players.find((p) => p.id === id)?.name),
      ...aiPickIds.map((id) => {
        const pk = draftPicks.find((x) => x.id === id);
        return pk ? `${pk.year} Rd ${pk.round} (${pk.originalTeamId})` : "";
      }),
    ].filter(Boolean);

    addTransaction(
      "TRADE",
      `BLOCKBUSTER: ${userTeamId} receives [${aAssets.join(", ")}] from ${partnerTeamId} for [${uAssets.join(", ")}].`
    );
    showToast(`Trade completed with ${teamMap[partnerTeamId]?.city} ${teamMap[partnerTeamId]?.name}!`, "success");
    return true;
  };

  // ==========================================================================
  // RENDER: NEW GAME FRANCHISE SELECTION SCREEN
  // ==========================================================================

  if (phase === "SETUP") {
    return (
      <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col justify-between p-4 sm:p-8">
        <div className="max-w-7xl mx-auto w-full">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6 mb-8">
            <div>
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold tracking-wide uppercase mb-2">
                <Trophy className="w-3.5 h-3.5" /> Front Office Baseball Simulation
              </div>
              <h1 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                Diamond Dynasty GM
              </h1>
              <p className="text-slate-400 mt-1 max-w-2xl text-sm sm:text-base">
                Take control of 1 of 32 franchises across 2 Leagues & 6 Divisions. Draft from a 1,344-player pool, manage a 30-man active roster & 384-player waiver wire, trade players and future draft picks, and build a multi-season dynasty.
              </p>
            </div>
            <button
              onClick={() => startNewFranchise(userTeamId)}
              className="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-bold text-base shadow-lg shadow-emerald-500/20 transition cursor-pointer shrink-0"
            >
              <Play className="w-5 h-5 fill-current" />
              Start Inaugural Draft as {teamMap[userTeamId]?.city || TEAM_CONFIGS.find(t => t.id === userTeamId)?.city}
            </button>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {["AL", "NL"].map((lg) => (
              <div key={lg} className="bg-slate-900/80 border border-slate-800 rounded-2xl p-5">
                <h2 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
                  <Shield className="w-5 h-5 text-sky-400" />
                  {lg === "AL" ? "American League (16 Teams)" : "National League (16 Teams)"}
                </h2>
                <div className="space-y-4">
                  {["East", "Central", "West"].map((div) => {
                    const divTeams = TEAM_CONFIGS.filter((t) => t.league === lg && t.division === div);
                    return (
                      <div key={div}>
                        <div className="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                          {lg} {div} ({divTeams.length} Teams)
                        </div>
                        <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                          {divTeams.map((t) => {
                            const selected = userTeamId === t.id;
                            return (
                              <button
                                key={t.id}
                                onClick={() => setUserTeamId(t.id)}
                                className={`flex items-center gap-2.5 p-2.5 rounded-xl border text-left transition cursor-pointer ${
                                  selected
                                    ? "bg-sky-500/15 border-sky-400 ring-2 ring-sky-500/30"
                                    : "bg-slate-950/70 border-slate-800 hover:border-slate-600"
                                }`}
                              >
                                <TeamBadge team={t} />
                                <div className="min-w-0">
                                  <div className="text-xs font-bold text-white truncate">{t.city}</div>
                                  <div className="text-[11px] text-slate-400 truncate">{t.name}</div>
                                </div>
                              </button>
                            );
                          })}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }

  // ==========================================================================
  // RENDER: MAIN FRONT OFFICE SHELL
  // ==========================================================================

  const userRoster = playersByTeam.byTeam[userTeamId] || [];
  const waiverPool = playersByTeam.waivers || [];
  const isDraftPhase = phase === "INAUGURAL_DRAFT" || phase === "ROOKIE_DRAFT";

  const navItems = [
    { id: "dashboard", label: "Dashboard & Sim", icon: Activity, disabled: isDraftPhase },
    { id: "roster", label: `My Roster (${userRoster.length}/30)`, icon: Users, disabled: false },
    { id: "standings", label: "Standings & Leaders", icon: BarChart3, disabled: isDraftPhase },
    { id: "waivers", label: `Waiver Pool (${waiverPool.length})`, icon: UserPlus, disabled: isDraftPhase },
    { id: "trades", label: "Trade Center", icon: ArrowLeftRight, disabled: isDraftPhase },
    { id: "draft", label: isDraftPhase ? "Draft Room (LIVE)" : "Draft Picks & History", icon: ListOrdered, disabled: false },
    { id: "log", label: "Transactions", icon: FileText, disabled: false },
  ];

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col">
      {/* Top Executive Header */}
      <header className="bg-slate-900 border-b border-slate-800 sticky top-0 z-30">
        <div className="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <TeamBadge team={userTeam} size="lg" />
            <div>
              <div className="flex items-center gap-2">
                <span className="font-extrabold text-white text-base sm:text-lg">
                  {userTeam?.city} {userTeam?.name}
                </span>
                <span className="text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">
                  {userTeam?.league} {userTeam?.division}
                </span>
              </div>
              <div className="text-xs text-slate-400 flex items-center gap-3 mt-0.5">
                <span className="font-semibold text-sky-400">Season {year}</span>
                <span>•</span>
                <span>
                  Record: <strong className="text-white">{userTeam?.wins}-{userTeam?.losses}</strong>
                </span>
                <span>•</span>
                <span>
                  {phase === "INAUGURAL_DRAFT" && "Inaugural 30-Rd Draft"}
                  {phase === "ROOKIE_DRAFT" && `${year} Rookie Draft`}
                  {phase === "ROSTER_CUTS" && "Offseason Roster Cuts"}
                  {phase === "REGULAR_SEASON" && `Day ${currentDay} / 162`}
                  {phase === "PLAYOFFS_COMPLETE" && "Offseason / Playoffs Complete"}
                </span>
              </div>
            </div>
          </div>

          {/* Quick Action Simulation Controls in Header */}
          <div className="flex flex-wrap items-center gap-2">
            {phase === "REGULAR_SEASON" && currentDay < 162 && (
              <>
                <button
                  onClick={() => simulateDays(1)}
                  className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition cursor-pointer"
                >
                  <Play className="w-3.5 h-3.5 text-emerald-400" /> Sim Game
                </button>
                <button
                  onClick={() => simulateDays(7)}
                  className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition cursor-pointer"
                >
                  <FastForward className="w-3.5 h-3.5 text-sky-400" /> Sim Week
                </button>
                <button
                  onClick={() => simulateDays(30)}
                  className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 transition cursor-pointer"
                >
                  <SkipForward className="w-3.5 h-3.5 text-indigo-400" /> Sim Month
                </button>
                <button
                  onClick={() => simulateDays(162 - currentDay)}
                  className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold shadow transition cursor-pointer"
                >
                  <Trophy className="w-3.5 h-3.5" /> Sim Season
                </button>
              </>
            )}

            {phase === "PLAYOFFS_COMPLETE" && (
              <button
                onClick={advanceToOffseasonRookieDraft}
                className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow transition cursor-pointer"
              >
                <Sparkles className="w-4 h-4" /> Advance to {year + 1} Rookie Draft
              </button>
            )}

            {phase === "ROSTER_CUTS" && (
              <button
                onClick={confirmRosterCutsComplete}
                className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold shadow transition cursor-pointer"
              >
                <Check className="w-4 h-4" /> Finalize 30-Man Roster ({userRoster.length}/30)
              </button>
            )}

            <button
              onClick={() => setPhase("SETUP")}
              title="Start a New Franchise"
              className="p-2 rounded-lg bg-slate-800/70 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-700/70 transition cursor-pointer"
            >
              <RefreshCw className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

        {/* Navigation Tabs */}
        <div className="max-w-7xl mx-auto px-4 flex items-center gap-1 overflow-x-auto no-scrollbar border-t border-slate-800/80">
          {navItems.map((item) => {
            const Icon = item.icon;
            const active = activeTab === item.id;
            return (
              <button
                key={item.id}
                disabled={item.disabled}
                onClick={() => setActiveTab(item.id)}
                className={`flex items-center gap-2 px-3.5 py-2.5 text-xs font-semibold border-b-2 whitespace-nowrap transition cursor-pointer ${
                  item.disabled
                    ? "opacity-40 cursor-not-allowed border-transparent text-slate-500"
                    : active
                    ? "border-sky-400 text-sky-400 bg-sky-500/5"
                    : "border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-800/40"
                }`}
              >
                <Icon className="w-3.5 h-3.5" />
                {item.label}
              </button>
            );
          })}
        </div>
      </header>

      {/* Live League News Ticker */}
      {transactions.length > 0 && (
        <div className="bg-slate-900/60 border-b border-slate-800/80 py-1.5 px-4">
          <div className="max-w-7xl mx-auto flex items-center gap-3 text-xs overflow-hidden">
            <span className="px-2 py-0.5 rounded bg-sky-500/15 text-sky-400 font-bold uppercase tracking-wider text-[10px] shrink-0">
              MLB Wire
            </span>
            <span className="text-slate-300 truncate">{transactions[0].summary}</span>
          </div>
        </div>
      )}

      {/* Toast Notification */}
      {toastMsg && (
        <div className="fixed bottom-5 right-5 z-50 max-w-md bg-slate-900 border border-slate-700 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3">
          <AlertCircle className={`w-5 h-5 shrink-0 ${toastMsg.type === "error" ? "text-rose-400" : toastMsg.type === "warning" ? "text-amber-400" : "text-emerald-400"}`} />
          <span className="text-xs sm:text-sm font-medium">{toastMsg.text}</span>
        </div>
      )}

      {/* Main Content Area */}
      <main className="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6">
        {activeTab === "dashboard" && (
          <DashboardView
            year={year}
            phase={phase}
            currentDay={currentDay}
            userTeam={userTeam}
            userRoster={userRoster}
            teams={teams}
            teamMap={teamMap}
            recentGames={recentGames}
            transactions={transactions}
            playoffResults={playoffResults}
            championsHistory={championsHistory}
            draftPicks={draftPicks}
            onSimDays={simulateDays}
            onAdvanceOffseason={advanceToOffseasonRookieDraft}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
            onNavigate={setActiveTab}
          />
        )}

        {activeTab === "roster" && (
          <RosterView
            userTeam={userTeam}
            userRoster={userRoster}
            phase={phase}
            onReleasePlayer={handleReleasePlayer}
            onConfirmCuts={confirmRosterCutsComplete}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
          />
        )}

        {activeTab === "standings" && (
          <StandingsAndStatsView
            teams={teams}
            players={players}
            teamMap={teamMap}
            userTeamId={userTeamId}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
          />
        )}

        {activeTab === "waivers" && (
          <WaiverPoolView
            waiverPool={waiverPool}
            userRoster={userRoster}
            onClaimAndDrop={handleWaiverClaimAndDrop}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
          />
        )}

        {activeTab === "trades" && (
          <TradeCenterView
            year={year}
            userTeam={userTeam}
            teams={teams}
            teamMap={teamMap}
            playersByTeam={playersByTeam.byTeam}
            draftPicks={draftPicks}
            onExecuteTrade={executeTrade}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
          />
        )}

        {activeTab === "draft" && (
          <DraftRoomView
            year={year}
            phase={phase}
            userTeamId={userTeamId}
            teamMap={teamMap}
            teams={teams}
            draftOrder={draftOrder}
            currentPickIdx={currentPickIdx}
            draftPool={draftPool}
            draftHistory={draftHistory}
            userRoster={userRoster}
            draftPicks={draftPicks}
            onUserPick={handleUserDraftSelect}
            onSimNext={handleSimNextPick}
            onSimToUser={handleSimToUserTurn}
            onAutoDraftAll={handleAutoDraftAll}
            onSelectPlayer={(p) => setSelectedPlayer(p)}
          />
        )}

        {activeTab === "log" && (
          <TransactionsLogView transactions={transactions} championsHistory={championsHistory} />
        )}
      </main>

      {/* Player Modal */}
      {selectedPlayer && (
        <PlayerDetailModal
          player={selectedPlayer}
          team={selectedPlayer.teamId ? teamMap[selectedPlayer.teamId] : null}
          onClose={() => setSelectedPlayer(null)}
        />
      )}
    </div>
  );
}

// ============================================================================
// 7. SUB-VIEWS
// ============================================================================

function DashboardView({
  year, phase, currentDay, userTeam, userRoster, teams, teamMap,
  recentGames, transactions, playoffResults, championsHistory, draftPicks,
  onSimDays, onAdvanceOffseason, onSelectPlayer, onNavigate
}) {
  const hitters = userRoster.filter((p) => !p.isPitcher);
  const pitchers = userRoster.filter((p) => p.isPitcher);
  const avgHitterOvr = hitters.length ? Math.round(hitters.reduce((s, p) => s + p.ovr, 0) / hitters.length) : 0;
  const avgPitcherOvr = pitchers.length ? Math.round(pitchers.reduce((s, p) => s + p.ovr, 0) / pitchers.length) : 0;
  const teamOvr = Math.round((avgHitterOvr + avgPitcherOvr) / 2);

  // Division standings for user's division
  const divTeams = teams
    .filter((t) => t.league === userTeam?.league && t.division === userTeam?.division)
    .sort((a, b) => b.wins - a.wins || (b.runsScored - b.runsAllowed) - (a.runsScored - a.runsAllowed));

  const userPicks = draftPicks.filter((pk) => pk.ownerTeamId === userTeam?.id).sort((a, b) => a.year - b.year || a.round - b.round);

  return (
    <div className="space-y-6">
      {/* Playoff Banner if Season Ended */}
      {phase === "PLAYOFFS_COMPLETE" && playoffResults && (
        <div className="bg-gradient-to-r from-amber-500/20 via-slate-900 to-emerald-500/20 border border-amber-500/40 rounded-2xl p-6">
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <div className="inline-flex items-center gap-2 text-amber-400 text-xs font-bold uppercase tracking-wider mb-1">
                <Trophy className="w-4 h-4" /> {year} World Series Champions
              </div>
              <h2 className="text-2xl font-extrabold text-white flex items-center gap-3">
                <TeamBadge team={playoffResults.champion} size="lg" />
                {playoffResults.champion.city} {playoffResults.champion.name}
                <span className="text-sm font-normal text-slate-300">
                  def. {playoffResults.runnerUp.city} {playoffResults.runnerUp.name} ({playoffResults.rounds.worldSeries.score})
                </span>
              </h2>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3 text-xs text-slate-300">
                <div>
                  <span className="text-slate-400 font-semibold">ALCS:</span> {playoffResults.rounds.championship[0].winner.id} def. {playoffResults.rounds.championship[0].loser.id} ({playoffResults.rounds.championship[0].score})
                </div>
                <div>
                  <span className="text-slate-400 font-semibold">NLCS:</span> {playoffResults.rounds.championship[1].winner.id} def. {playoffResults.rounds.championship[1].loser.id} ({playoffResults.rounds.championship[1].score})
                </div>
              </div>
            </div>
            <button
              onClick={onAdvanceOffseason}
              className="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-lg transition cursor-pointer shrink-0"
            >
              Proceed to {year + 1} Offseason & Rookie Draft →
            </button>
          </div>
        </div>
      )}

      {/* Top KPI Cards */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <div className="text-xs text-slate-400 font-medium">Season Record</div>
          <div className="text-2xl font-extrabold text-white mt-1">
            {userTeam?.wins}-{userTeam?.losses}
          </div>
          <div className="text-xs text-slate-400 mt-1">
            Win%: {userTeam && userTeam.wins + userTeam.losses > 0 ? (userTeam.wins / (userTeam.wins + userTeam.losses)).toFixed(3).replace(/^0/, "") : ".000"} • Streak: {userTeam?.streak > 0 ? `W${userTeam.streak}` : userTeam?.streak < 0 ? `L${Math.abs(userTeam.streak)}` : "-"}
          </div>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <div className="text-xs text-slate-400 font-medium">Franchise Overall</div>
          <div className="flex items-center gap-2 mt-1">
            <span className="text-2xl font-extrabold text-white">{teamOvr}</span>
            <RatingBadge value={teamOvr} />
          </div>
          <div className="text-xs text-slate-400 mt-1">
            Offense: <span className="text-emerald-400 font-semibold">{avgHitterOvr}</span> • Pitching: <span className="text-sky-400 font-semibold">{avgPitcherOvr}</span>
          </div>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <div className="text-xs text-slate-400 font-medium">Run Differential</div>
          <div className={`text-2xl font-extrabold mt-1 ${(userTeam?.runsScored - userTeam?.runsAllowed) >= 0 ? "text-emerald-400" : "text-rose-400"}`}>
            {(userTeam?.runsScored - userTeam?.runsAllowed) >= 0 ? "+" : ""}
            {(userTeam?.runsScored || 0) - (userTeam?.runsAllowed || 0)}
          </div>
          <div className="text-xs text-slate-400 mt-1">
            RS: {userTeam?.runsScored} • RA: {userTeam?.runsAllowed}
          </div>
        </div>

        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4">
          <div className="text-xs text-slate-400 font-medium">Schedule Progress</div>
          <div className="text-2xl font-extrabold text-white mt-1">
            {currentDay} <span className="text-sm font-normal text-slate-400">/ 162</span>
          </div>
