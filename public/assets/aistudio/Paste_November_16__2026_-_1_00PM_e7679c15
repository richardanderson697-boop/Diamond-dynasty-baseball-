function WaiverPoolView({ waiverPool, userRoster, onClaimAndDrop, onSelectPlayer }) {
  const [search, setSearch] = useState("");
  const [posFilter, setPosFilter] = useState("ALL");
  const [handFilter, setHandFilter] = useState("ALL");
  const [claimingPlayer, setClaimingPlayer] = useState(null);
  const [selectedDropId, setSelectedDropId] = useState("");

  const filteredWaivers = useMemo(() => {
    return waiverPool
      .filter((p) => {
        if (search && !p.name.toLowerCase().includes(search.toLowerCase())) return false;
        if (posFilter === "PITCHERS" && !p.isPitcher) return false;
        if (posFilter === "HITTERS" && p.isPitcher) return false;
        if (!["ALL", "PITCHERS", "HITTERS"].includes(posFilter) && p.position !== posFilter) return false;
        if (handFilter !== "ALL" && p.throws !== handFilter && p.bats !== handFilter) return false;
        return true;
      })
      .slice(0, 120);
  }, [waiverPool, search, posFilter, handFilter]);

  const openClaimModal = (player) => {
    setClaimingPlayer(player);
    const lowest = [...userRoster].sort((a, b) => a.ovr - b.ovr)[0];
    setSelectedDropId(lowest ? lowest.id : "");
  };

  return (
    <div className="space-y-5">
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 className="text-lg font-bold text-white">League Waiver Wire & Free Agent Pool ({waiverPool.length})</h2>
          <p className="text-xs text-slate-400">
            Claim any available player by simultaneously designating a player from your 30-man roster to waive.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <div className="relative">
            <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" />
            <input
              type="text"
              placeholder="Search player..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              className="pl-8 pr-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-sky-500"
            />
          </div>

          <select
            value={posFilter}
            onChange={(e) => setPosFilter(e.target.value)}
            className="px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
          >
            <option value="ALL">All Positions</option>
            <option value="HITTERS">All Hitters</option>
            <option value="PITCHERS">All Pitchers</option>
            {["C", "1B", "2B", "3B", "SS", "LF", "CF", "RF", "DH", "SP", "RP"].map((pos) => (
              <option key={pos} value={pos}>{pos}</option>
            ))}
          </select>

          <select
            value={handFilter}
            onChange={(e) => setHandFilter(e.target.value)}
            className="px-3 py-1.5 rounded-lg bg-slate-950 border border-slate-800 text-xs text-white"
          >
            <option value="ALL">L / R / S</option>
            <option value="L">Left-Handed (L)</option>
            <option value="R">Right-Handed (R)</option>
          </select>
        </div>
      </div>

      {/* Waiver Table */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full text-xs text-left">
            <thead className="bg-slate-950 text-slate-400 uppercase text-[11px]">
              <tr>
                <th className="py-3 px-4">Pos</th>
                <th className="py-3 px-3">Player</th>
                <th className="py-3 px-2 text-center">Age</th>
                <th className="py-3 px-2 text-center">B/T</th>
                <th className="py-3 px-2 text-center">OVR</th>
                <th className="py-3 px-2 text-center">POT</th>
                <th className="py-3 px-3">Scouting Grades</th>
                <th className="py-3 px-4 text-right">Transaction</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/80">
              {filteredWaivers.map((p) => (
                <tr key={p.id} className="hover:bg-slate-800/40">
                  <td className="py-2.5 px-4">
                    <span className="px-2 py-0.5 rounded bg-slate-800 font-bold text-sky-400">{p.position}</span>
                  </td>
                  <td className="py-2.5 px-3 font-bold text-white cursor-pointer hover:text-sky-400" onClick={() => onSelectPlayer(p)}>
                    {p.name}
                  </td>
                  <td className="py-2.5 px-2 text-center font-mono">{p.age}</td>
                  <td className="py-2.5 px-2 text-center font-mono text-slate-400">{p.bats}/{p.throws}</td>
                  <td className="py-2.5 px-2 text-center"><RatingBadge value={p.ovr} /></td>
                  <td className="py-2.5 px-2 text-center font-mono text-amber-300">{p.potential}</td>
                  <td className="py-2.5 px-3 font-mono text-slate-300">
                    {p.isPitcher
                      ? `VEL ${p.velocity} • CTL ${p.control} • FIN ${p.finesse}`
                      : `POW ${p.power} • SPD ${p.speed} • GLV ${p.glove}`}
                  </td>
                  <td className="py-2.5 px-4 text-right">
                    <button
                      onClick={() => openClaimModal(p)}
                      className="px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/35 text-emerald-300 border border-emerald-500/40 font-semibold text-xs transition cursor-pointer"
                    >
                      Claim Player
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      {/* Claim & Simultaneous Drop Modal */}
      {claimingPlayer && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4">
          <div className="bg-slate-900 border border-slate-700 rounded-xl max-w-md w-full p-6 shadow-2xl">
            <h3 className="text-lg font-bold text-white">Complete Waiver Claim</h3>
            <p className="text-xs text-slate-400 mt-1">
              Claiming <strong className="text-emerald-400">{claimingPlayer.position} {claimingPlayer.name} ({claimingPlayer.ovr} OVR)</strong>.
              {userRoster.length >= 30
                ? " Select a player from your 30-man active roster to release:"
                : " You have an open roster spot."}
            </p>

            {userRoster.length >= 30 && (
              <div className="mt-4">
                <label className="block text-xs font-semibold text-slate-300 mb-1.5">Player to Waive / Drop</label>
                <select
                  value={selectedDropId}
                  onChange={(e) => setSelectedDropId(e.target.value)}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white"
                >
                  {[...userRoster]
                    .sort((a, b) => a.ovr - b.ovr)
                    .map((rp) => (
                      <option key={rp.id} value={rp.id}>
                        [{rp.position}] {rp.name} — {rp.ovr} OVR (Age {rp.age})
                      </option>
                    ))}
                </select>
              </div>
            )}

            <div className="flex justify-end gap-2 mt-6">
              <button
                onClick={() => setClaimingPlayer(null)}
                className="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 text-xs font-semibold cursor-pointer"
              >
                Cancel
              </button>
              <button
                onClick={() => {
                  onClaimAndDrop(claimingPlayer.id, userRoster.length >= 30 ? selectedDropId : null);
                  setClaimingPlayer(null);
                }}
                className="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold cursor-pointer"
              >
                Confirm Claim & Move
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function TradeCenterView({ year, userTeam, teams, teamMap, playersByTeam, draftPicks, onExecuteTrade, onSelectPlayer }) {
  const aiTeams = useMemo(() => teams.filter((t) => t.id !== userTeam?.id), [teams, userTeam]);
  const [partnerId, setPartnerId] = useState(aiTeams[0]?.id || "BOS");

  const [userSelPlayers, setUserSelPlayers] = useState([]);
  const [userSelPicks, setUserSelPicks] = useState([]);
  const [aiSelPlayers, setAiSelPlayers] = useState([]);
  const [aiSelPicks, setAiSelPicks] = useState([]);

  const handleChangePartner = (newId) => {
    setPartnerId(newId);
    setAiSelPlayers([]);
    setAiSelPicks([]);
  };

  const toggleItem = (list, setList, id) => {
    if (list.includes(id)) setList(list.filter((x) => x !== id));
    else if (list.length < 4) setList([...list, id]);
  };

  const partnerTeam = teamMap[partnerId];
  const userRoster = playersByTeam[userTeam?.id] || [];
  const partnerRoster = playersByTeam[partnerId] || [];

  const userPicks = draftPicks
    .filter((pk) => pk.ownerTeamId === userTeam?.id)
    .sort((a, b) => a.year - b.year || a.round - b.round);
  const partnerPicks = draftPicks
    .filter((pk) => pk.ownerTeamId === partnerId)
    .sort((a, b) => a.year - b.year || a.round - b.round);

  // Calculate Live Trade Values & AI Evaluation
  const evaluation = useMemo(() => {
    const uPlayerVal = userSelPlayers.reduce((sum, id) => {
      const p = userRoster.find((x) => x.id === id);
      return sum + (p ? getPlayerTradeValue(p) : 0);
    }, 0);
    const uPickVal = userSelPicks.reduce((sum, id) => {
      const pk = userPicks.find((x) => x.id === id);
      return sum + (pk ? getDraftPickTradeValue(pk, teams, year) : 0);
    }, 0);

    const aPlayerVal = aiSelPlayers.reduce((sum, id) => {
      const p = partnerRoster.find((x) => x.id === id);
      return sum + (p ? getPlayerTradeValue(p) : 0);
    }, 0);
    const aPickVal = aiSelPicks.reduce((sum, id) => {
      const pk = partnerPicks.find((x) => x.id === id);
      return sum + (pk ? getDraftPickTradeValue(pk, teams, year) : 0);
    }, 0);

    const userTotal = uPlayerVal + uPickVal;
    const aiTotal = aPlayerVal + aPickVal;
    const hasAssets = userTotal > 0 && aiTotal > 0;

    // AI GM demands at least 94% of outgoing value, plus slight tax if trading away an 84+ OVR star
    const starTax = aiSelPlayers.some((id) => (partnerRoster.find((p) => p.id === id)?.ovr || 0) >= 84) ? 1.08 : 1.0;
    const ratio = aiTotal > 0 ? userTotal / (aiTotal * starTax) : 0;

    let status = "EMPTY";
    let message = "Select players and/or future draft picks on both sides to construct a trade proposal.";
    if (hasAssets) {
      if (ratio >= 0.96) {
        status = "ACCEPT";
        message = `${partnerTeam?.city} GM: "This deal aligns with our organizational timeline. We accept!"`;
      } else if (ratio >= 0.82) {
        status = "CLOSE";
        message = `${partnerTeam?.city} GM: "We're close, but we need slightly more value—add a mid-round pick or upgrade a prospect."`;
      } else {
        status = "REJECT";
        message = `${partnerTeam?.city} GM: "We cannot justify moving these assets for that return."`;
      }
    }

    return { userTotal, aiTotal, ratio, status, message };
  }, [userSelPlayers, userSelPicks, aiSelPlayers, aiSelPicks, userRoster, partnerRoster, userPicks, partnerPicks, teams, year, partnerTeam]);

  const handlePropose = () => {
    if (evaluation.status !== "ACCEPT") return;
    const ok = onExecuteTrade(partnerId, userSelPlayers, userSelPicks, aiSelPlayers, aiSelPicks);
    if (ok) {
      setUserSelPlayers([]);
      setUserSelPicks([]);
      setAiSelPlayers([]);
      setAiSelPicks([]);
    }
  };

  return (
    <div className="space-y-5">
      {/* Header & Evaluation Meter */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800">
          <div>
            <h2 className="text-lg font-bold text-white flex items-center gap-2">
              <ArrowLeftRight className="w-5 h-5 text-sky-400" />
              Front Office Trade Center
            </h2>
            <p className="text-xs text-slate-400 mt-0.5">
              Package up to 4 players and 4 future draft picks per side. Keep resulting rosters at or below 30 players.
            </p>
          </div>

          <div className="flex items-center gap-3">
            <span className="text-xs text-slate-400 font-semibold">Trade Partner:</span>
            <select
              value={partnerId}
              onChange={(e) => handleChangePartner(e.target.value)}
              className="px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-xs font-bold text-white"
            >
              {aiTeams.map((t) => (
                <option key={t.id} value={t.id}>
                  {t.city} {t.name} ({t.wins}-{t.losses})
                </option>
              ))}
            </select>
          </div>
        </div>

        {/* Live Trade Fairness Meter */}
        <div className="mt-4 grid grid-cols-1 lg:grid-cols-3 gap-4 items-center">
          <div className="bg-slate-950/80 border border-slate-800 rounded-lg p-3 flex items-center justify-between">
            <div>
              <div className="text-[11px] text-slate-400">You Send ({userTeam?.id})</div>
              <div className="text-lg font-extrabold text-white font-mono">{evaluation.userTotal} pts</div>
            </div>
            <div className="text-right">
              <div className="text-[11px] text-slate-400">You Receive ({partnerId})</div>
              <div className="text-lg font-extrabold text-sky-400 font-mono">{evaluation.aiTotal} pts</div>
            </div>
          </div>

          <div className="bg-slate-950/80 border border-slate-800 rounded-lg p-3">
            <div className="flex justify-between text-[11px] mb-1">
              <span className="text-slate-400">AI GM Interest Meter</span>
              <span
                className={`font-bold ${
                  evaluation.status === "ACCEPT"
                    ? "text-emerald-400"
                    : evaluation.status === "CLOSE"
                    ? "text-amber-400"
                    : "text-slate-400"
                }`}
              >
                {evaluation.status}
              </span>
            </div>
            <div className="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
              <div
                className={`h-full transition-all ${
                  evaluation.status === "ACCEPT"
                    ? "bg-emerald-500"
                    : evaluation.status === "CLOSE"
                    ? "bg-amber-500"
                    : "bg-rose-500"
                }`}
                style={{ width: `${Math.min(100, Math.round(evaluation.ratio * 85))}%` }}
              />
            </div>
            <p className="text-[11px] text-slate-300 mt-1.5">{evaluation.message}</p>
          </div>

          <div className="flex justify-end">
            <button
              disabled={evaluation.status !== "ACCEPT"}
              onClick={handlePropose}
              className="w-full lg:w-auto px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 disabled:opacity-35 disabled:cursor-not-allowed text-slate-950 font-extrabold text-xs shadow-lg transition cursor-pointer"
            >
              Execute Trade Proposal
            </button>
          </div>
        </div>
      </div>

      {/* Dual Team Asset Selector */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {[
          {
            title: `${userTeam?.city} ${userTeam?.name} (Your Assets)`,
            roster: userRoster,
            picks: userPicks,
            selPlayers: userSelPlayers,
            setSelPlayers: setUserSelPlayers,
            selPicks: userSelPicks,
            setSelPicks: setUserSelPicks,
          },
          {
            title: `${partnerTeam?.city} ${partnerTeam?.name} (${partnerId} Assets)`,
            roster: partnerRoster,
            picks: partnerPicks,
            selPlayers: aiSelPlayers,
            setSelPlayers: setAiSelPlayers,
            selPicks: aiSelPicks,
            setSelPicks: setAiSelPicks,
          },
        ].map((side, idx) => (
          <div key={idx} className="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-4">
            <h3 className="font-bold text-white text-sm border-b border-slate-800 pb-2">{side.title}</h3>

            {/* Future Draft Picks */}
            <div>
              <div className="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                Future Draft Picks (Click to Include)
              </div>
              <div className="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto">
                {side.picks.map((pk) => {
                  const active = side.selPicks.includes(pk.id);
                  const val = getDraftPickTradeValue(pk, teams, year);
                  return (
                    <button
                      key={pk.id}
                      onClick={() => toggleItem(side.selPicks, side.setSelPicks, pk.id)}
                      className={`px-2.5 py-1 rounded text-[11px] font-mono border transition cursor-pointer ${
                        active
                          ? "bg-sky-500 text-slate-950 border-sky-400 font-bold"
                          : "bg-slate-950 text-slate-300 border-slate-800 hover:border-slate-600"
                      }`}
                    >
                      {pk.year} R{pk.round} ({pk.originalTeamId}) • {val}p
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Active 30-Man Roster */}
            <div>
              <div className="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                Active Roster ({side.roster.length}/30)
              </div>
              <div className="max-h-80 overflow-y-auto divide-y divide-slate-800/70 border border-slate-800 rounded-lg">
                {side.roster.map((p) => {
                  const active = side.selPlayers.includes(p.id);
                  const val = getPlayerTradeValue(p);
                  return (
                    <div
                      key={p.id}
                      onClick={() => toggleItem(side.selPlayers, side.setSelPlayers, p.id)}
                      className={`flex items-center justify-between px-3 py-2 text-xs cursor-pointer transition ${
                        active ? "bg-sky-500/20 text-white" : "hover:bg-slate-800/40"
                      }`}
                    >
                      <div className="flex items-center gap-2 min-w-0">
                        <input type="checkbox" checked={active} readOnly className="rounded accent-sky-500" />
                        <span className="px-1.5 py-0.5 rounded bg-slate-800 text-sky-400 font-bold text-[10px]">
                          {p.position}
                        </span>
                        <span
                          className="font-semibold truncate hover:underline"
                          onClick={(e) => {
                            e.stopPropagation();
                            onSelectPlayer(p);
                          }}
                        >
                          {p.name}
                        </span>
                        <span className="text-[11px] text-slate-500">({p.age}y)</span>
                      </div>
                      <div className="flex items-center gap-2 shrink-0">
                        <span className="text-[11px] font-mono text-slate-400">{val}p</span>
                        <RatingBadge value={p.ovr} />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function DraftRoomView({
  year, phase, userTeamId, teamMap, teams, draftOrder, currentPickIdx,
  draftPool, draftHistory, userRoster, draftPicks,
  onUserPick, onSimNext, onSimToUser, onAutoDraftAll, onSelectPlayer
}) {
  const [posFilter, setPosFilter] = useState("ALL");
  const isLiveDraft = phase === "INAUGURAL_DRAFT" || phase === "ROOKIE_DRAFT";
  const currentSlot = draftOrder[currentPickIdx];
  const isUserTurn = isLiveDraft && currentSlot?.teamId === userTeamId;

  const { counts, totalHitters, totalPitchers } = useMemo(() => getTeamRosterNeeds(userRoster), [userRoster]);

  const visiblePool = useMemo(() => {
    return draftPool
      .filter((p) => {
        if (posFilter === "ALL") return true;
        if (posFilter === "HITTERS") return !p.isPitcher;
        if (posFilter === "PITCHERS") return p.isPitcher;
        return p.position === posFilter;
      })
      .slice(0, 120);
  }, [draftPool, posFilter]);

  if (!isLiveDraft) {
    // Show Future Draft Capital Overview & Past Draft History
    return (
      <div className="space-y-6">
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
          <h2 className="text-lg font-bold text-white mb-1">Future Draft Picks & Recent Draft Log</h2>
          <p className="text-xs text-slate-400 mb-4">
            Annual 5-round Rookie Draft order is strictly determined by reverse regular-season standings (worst record picks #1, best picks #32).
          </p>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            {[year + 1, year + 2, year + 3].map((yr) => {
              const owned = draftPicks.filter((pk) => pk.year === yr && pk.ownerTeamId === userTeamId);
              return (
                <div key={yr} className="bg-slate-950 border border-slate-800 rounded-lg p-4">
                  <div className="text-sm font-bold text-sky-400 mb-2">{yr} Rookie Draft Picks ({owned.length})</div>
                  <div className="space-y-1.5">
                    {owned.map((pk) => (
                      <div key={pk.id} className="text-xs flex justify-between text-slate-300 font-mono">
                        <span>Round {pk.round}</span>
                        <span>
                          {pk.originalTeamId === userTeamId ? "Own Pick" : `via ${pk.originalTeamId}`}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {draftHistory.length > 0 && (
          <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
            <h3 className="text-sm font-bold text-white mb-3">Most Recent Draft Selections</h3>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 max-h-96 overflow-y-auto">
              {draftHistory.slice(0, 64).map((h) => (
                <div key={h.pickNum} className="p-2 rounded bg-slate-950 border border-slate-800 text-xs flex items-center justify-between">
                  <div className="truncate">
                    <span className="text-slate-500 font-mono mr-1.5">#{h.pickNum}</span>
                    <strong className="text-sky-400 mr-1.5">{h.teamId}</strong>
                    <span className="text-white font-semibold">{h.player.name}</span>
                  </div>
                  <RatingBadge value={h.player.ovr} />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    );
  }

  return (
    <div className="space-y-5">
      {/* Live Draft Clock Header */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <div className="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold uppercase mb-1.5">
              {phase === "INAUGURAL_DRAFT" ? "30-Round Inaugural Fantasy Draft" : `${year} 5-Round Rookie Prospect Draft`}
            </div>
            <h2 className="text-xl font-extrabold text-white flex items-center gap-2.5">
              On the Clock:
              {currentSlot && (
                <>
                  <TeamBadge team={teamMap[currentSlot.teamId]} size="lg" />
                  <span>
                    {teamMap[currentSlot.teamId]?.city} {teamMap[currentSlot.teamId]?.name}
                  </span>
                  <span className="text-sm font-mono text-slate-400">
                    (Round {currentSlot.round}, Pick #{currentSlot.pickNum} of {draftOrder.length})
                  </span>
                </>
              )}
            </h2>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            <button
              onClick={onSimNext}
              className="px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold border border-slate-700 cursor-pointer"
            >
              Sim Next Pick
            </button>
            <button
              onClick={onSimToUser}
              className="px-3.5 py-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 text-xs font-bold cursor-pointer"
            >
              Sim to My Turn
            </button>
            <button
              onClick={onAutoDraftAll}
              className="px-3.5 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold cursor-pointer"
            >
              Auto-Draft Rest of Draft
            </button>
          </div>
        </div>

        {/* User Positional Needs Tracker */}
        <div className="mt-4 pt-3 border-t border-slate-800 flex flex-wrap items-center gap-2 text-xs">
          <span className="font-bold text-slate-300 mr-1">
            Your Roster ({userRoster.length}/30 • {totalHitters}H / {totalPitchers}P):
          </span>
          {["C", "1B", "2B", "3B", "SS", "LF", "CF", "RF", "DH", "SP", "RP"].map((pos) => (
            <span
              key={pos}
              className={`px-2 py-0.5 rounded font-mono border ${
                (counts[pos] || 0) === 0
                  ? "bg-rose-500/15 text-rose-300 border-rose-500/30"
                  : "bg-slate-950 text-slate-300 border-slate-800"
              }`}
            >
              {pos}: {counts[pos] || 0}
            </span>
          ))}
        </div>
      </div>

      {/* Main Draft Board & Recent Picks */}
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
          <div className="p-4 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
            <h3 className="font-bold text-white text-sm">
              Available Draft Pool ({draftPool.length} Remaining)
            </h3>
            <div className="flex flex-wrap gap-1">
              {["ALL", "HITTERS", "PITCHERS", "C", "1B", "2B", "3B", "SS", "OF", "SP", "RP"].map((f) => {
                if (f === "OF") return null;
                return (
                  <button
                    key={f}
                    onClick={() => setPosFilter(f)}
                    className={`px-2 py-1 rounded text-[11px] font-semibold cursor-pointer ${
                      posFilter === f ? "bg-sky-500 text-slate-950" : "bg-slate-800 text-slate-300"
                    }`}
                  >
                    {f}
                  </button>
                );
              })}
            </div>
          </div>

          <div className="overflow-x-auto max-h-[540px] overflow-y-auto">
            <table className="w-full text-xs text-left">
              <thead className="bg-slate-950 text-slate-400 sticky top-0">
                <tr>
                  <th className="py-2.5 px-3">Pos</th>
                  <th className="py-2.5 px-3">Player</th>
                  <th className="py-2.5 px-2 text-center">Age</th>
                  <th className="py-2.5 px-2 text-center">B/T</th>
                  <th className="py-2.5 px-2 text-center">OVR</th>
                  <th className="py-2.5 px-2 text-center">POT</th>
                  <th className="py-2.5 px-3">Attributes</th>
                  <th className="py-2.5 px-3 text-right">Draft</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/80">
                {visiblePool.map((p) => (
                  <tr key={p.id} className="hover:bg-slate-800/40">
                    <td className="py-2 px-3">
                      <span className="px-1.5 py-0.5 rounded bg-slate-800 font-bold text-sky-400">{p.position}</span>
                    </td>
                    <td
                      className="py-2 px-3 font-bold text-white cursor-pointer hover:text-sky-400"
                      onClick={() => onSelectPlayer(p)}
                    >
                      {p.name}
                    </td>
                    <td className="py-2 px-2 text-center font-mono">{p.age}</td>
                    <td className="py-2 px-2 text-center font-mono text-slate-400">{p.bats}/{p.throws}</td>
                    <td className="py-2 px-2 text-center"><RatingBadge value={p.ovr} /></td>
                    <td className="py-2 px-2 text-center font-mono text-amber-300">{p.potential}</td>
                    <td className="py-2 px-3 font-mono text-slate-300">
                      {p.isPitcher
                        ? `VEL ${p.velocity} • CTL ${p.control} • FIN ${p.finesse}`
                        : `POW ${p.power} • SPD ${p.speed} • GLV ${p.glove}`}
                    </td>
                    <td className="py-2 px-3 text-right">
                      <button
                        disabled={!isUserTurn}
                        onClick={() => onUserPick(p.id)}
                        className="px-3 py-1 rounded bg-emerald-500 hover:bg-emerald-400 disabled:opacity-30 disabled:cursor-not-allowed text-slate-950 font-bold text-[11px] cursor-pointer"
                      >
                        Draft
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Live Pick Feed */}
        <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col">
          <h3 className="font-bold text-white text-sm mb-3">Draft Ticker</h3>
          <div className="space-y-2 max-h-[540px] overflow-y-auto pr-1">
            {draftHistory.length === 0 ? (
              <div className="text-xs text-slate-500 text-center py-8">Waiting for Pick #1...</div>
            ) : (
              draftHistory.slice(0, 60).map((entry) => (
                <div
                  key={entry.pickNum}
                  className={`p-2.5 rounded-lg border text-xs flex items-center justify-between ${
                    entry.teamId === userTeamId
                      ? "bg-sky-500/15 border-sky-500/40"
                      : "bg-slate-950/70 border-slate-800"
                  }`}
                >
                  <div className="min-w-0">
                    <div className="text-[11px] text-slate-400 font-mono">
                      Rd {entry.round} • Pick #{entry.pickNum} • <strong className="text-white">{entry.teamId}</strong>
                    </div>
                    <div className="font-bold text-slate-100 truncate mt-0.5">
                      [{entry.player.position}] {entry.player.name} <span className="text-slate-400 font-normal">({entry.player.age}y)</span>
                    </div>
                  </div>
                  <RatingBadge value={entry.player.ovr} />
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

